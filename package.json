{
  "name": "mafia-shadow-conflict",
  "version": "1.0.0",
  "description": "Jeu Mafia multijoueur en temps réel (Node.js, Socket.IO, Vanilla JS, Tailwind).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "MIN_PLAYERS=3 node --watch server.js",
    "build:css": "npx tailwindcss@3.4.17 -i ./styles/input.css -o ./public/css/app.css --minify",
    "watch:css": "npx tailwindcss@3.4.17 -i ./styles/input.css -o ./public/css/app.css --watch",
    "test": "node --test",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NNNNani/mafia-shadow-conflict.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/NNNNani/mafia-shadow-conflict/issues"
  },
  "homepage": "https://github.com/NNNNani/mafia-shadow-conflict#readme",
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "engines": {
    "node": ">=18"
  }
}
